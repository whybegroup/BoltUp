# Copy to `.env` in this folder (`cp .env.example .env`) and set values.
# `api/.env` is gitignored.

# Public site origin used in share-preview canonical URLs.
# PUBLIC_WEB_ORIGIN=https://moijia.com

# S3 file storage (required for uploads). Public image/file links use S3_PUBLIC_URL_BASE
# or https://{S3_BUCKET}.s3.{S3_REGION}.amazonaws.com/{key}.
# S3_BUCKET=
# S3_REGION=us-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional CDN or custom public origin (no trailing slash).
# S3_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-1.amazonaws.com
#
# Bucket CORS: allow PUT/OPTIONS from the app origin, AllowedHeaders *.
# Objects under storage/* should be publicly readable (or put CloudFront in front).
# Use bucket-owner-enforced (no object ACLs).
